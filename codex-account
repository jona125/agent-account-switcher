#!/bin/bash
# Compatibility launcher for the original command.
set -euo pipefail
path="${BASH_SOURCE[0]}"
while [[ -L "$path" ]]; do
  dir="$(cd -P "$(dirname "$path")" && pwd)"
  path="$(readlink "$path")"
  [[ "$path" == /* ]] || path="$dir/$path"
done
dir="$(cd -P "$(dirname "$path")" && pwd)"
exec "$dir/lib/codex-backend" "$@"
