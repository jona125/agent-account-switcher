#!/bin/bash
set -euo pipefail
umask 077
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" == /* ]] || script_path="$script_dir/$script_path"
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
config="$script_dir/config.xml"
if [[ -n "${CODEX_ACCOUNT_CONFIG:-}" ]]; then
  config="$CODEX_ACCOUNT_CONFIG"
else
  local_config="$script_dir/config.local.xml"
  if [[ ! -e "$local_config" && ! -L "$local_config" ]]; then
    python3 "$script_dir/lib/init_config.py" "$config" "$local_config" || \
      echo "Could not create $local_config; using default configuration." >&2
  fi
  [[ ! -e "$local_config" && ! -L "$local_config" ]] || config="$local_config"
fi
root="${CODEX_ACCOUNTS_DIR:-$(python3 "$script_dir/lib/read_config.py" "$config" accounts-dir)}"
shared="${CODEX_SHARED_HOME:-$(python3 "$script_dir/lib/read_config.py" "$config" shared-home)}"
python3 - "$script_dir" "$root" "$shared" <<'PY'
import os, sys
project = os.path.realpath(sys.argv[1])
for label, value in zip(('accounts-dir', 'shared-home'), sys.argv[2:]):
    path = os.path.realpath(os.path.expanduser(value))
    if os.path.commonpath((project, path)) == project:
        sys.exit(f'{label} must be outside the project directory: {value}')
PY
usage() {
  cat <<'HELP'
Usage: codex-account <command> [arguments]
  add NAME          Create an account and sign in interactively
  use NAME          Select the default account for future runs
  list              List accounts and indicate the selected one
  status [NAME]     Show Codex login status for an account
  login NAME        Sign in or reauthenticate an existing account
  run [--account NAME] [--] [CODEX ARGS...]
                    Run any Codex CLI command under the selected account
  help              Show this help

Examples:
  codex-account add personal
  codex-account add work
  codex-account use work
  codex-account run
  codex-account run --account personal -- exec 'Explain this project'
HELP
}
valid() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; }
check_name() { if ! valid "$1"; then echo 'Account name must contain only letters, digits, underscores, and hyphens, and start with a letter or digit.' >&2; exit 2; fi; }
require_account() { check_name "$1"; if [[ ! -d "$root/accounts/$1" || -L "$root/accounts/$1" ]]; then echo "Account '$1' does not exist." >&2; exit 1; fi; }
selected() { if [[ ! -f "$root/selected" ]]; then echo 'No account selected. Run: codex-account add NAME' >&2; exit 1; fi; IFS= read -r name < "$root/selected" || true; require_account "$name"; }
prepare() { mkdir -p "$root/accounts"; chmod 700 "$root" "$root/accounts"; }
prepare_shared() {
  local home="$root/accounts/$1" item target link
  [[ -d "$shared" && -d "$shared/sessions" ]] || { echo "Shared Codex home or sessions directory is missing: $shared" >&2; exit 1; }
  for item in sessions archived_sessions session_index.jsonl; do
    target="$shared/$item"; link="$home/$item"
    if [[ -L "$link" ]]; then
      [[ "$(readlink "$link")" == "$target" ]] || { echo "Existing $link points elsewhere; preserving it. Move it aside before proceeding." >&2; exit 1; }
    elif [[ -e "$link" ]]; then
      echo "Existing $link has separate history; preserving it. Move it aside before proceeding." >&2; exit 1
    else
      ln -s "$target" "$link"
    fi
  done
}
command_name="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$command_name" in
  help|-h|--help) usage ;;
  add)
    [[ $# == 1 ]] || { usage >&2; exit 2; }
    name="$1"; check_name "$name"; prepare
    if [[ -e "$root/accounts/$name" || -L "$root/accounts/$name" ]]; then echo "Account '$name' already exists; use login to reauthenticate." >&2; exit 1; fi
    mkdir "$root/accounts/$name"
    echo "Signing in to '$name'. Complete the Codex login in your browser."
    if CODEX_HOME="$root/accounts/$name" codex -c 'cli_auth_credentials_store="file"' login; then
      printf '%s\n' "$name" > "$root/selected"
      echo "Selected '$name'."
    else
      echo "Login failed; account directory retained. Retry with: codex-account login $name" >&2
      exit 1
    fi ;;
  login)
    [[ $# == 1 ]] || { usage >&2; exit 2; }; name="$1"; require_account "$name"
    CODEX_HOME="$root/accounts/$name" codex -c 'cli_auth_credentials_store="file"' login ;;
  use)
    [[ $# == 1 ]] || { usage >&2; exit 2; }; name="$1"; require_account "$name"; prepare
    tmp="$(mktemp "$root/.selected.XXXXXX")"; printf '%s\n' "$name" > "$tmp"; mv -f "$tmp" "$root/selected"
    echo "Selected '$name' for future codex-account runs." ;;
  list)
    [[ $# == 0 ]] || { usage >&2; exit 2; }; prepare
    active=''; [[ ! -f "$root/selected" ]] || IFS= read -r active < "$root/selected" || true
    found=0
    for dir in "$root"/accounts/*; do
      [[ -d "$dir" && ! -L "$dir" ]] || continue
      name="${dir##*/}"; found=1
      if [[ "$name" == "$active" ]]; then printf '* %s\n' "$name"; else printf '  %s\n' "$name"; fi
    done
    [[ $found == 1 ]] || echo 'No accounts yet. Run: codex-account add NAME' ;;
  status)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    if [[ $# == 1 ]]; then name="$1"; require_account "$name"; else selected; fi
    echo "Account: $name"
    CODEX_HOME="$root/accounts/$name" codex -c 'cli_auth_credentials_store="file"' login status ;;
  run)
    if [[ "${1:-}" == --account ]]; then [[ $# -ge 2 ]] || { usage >&2; exit 2; }; name="$2"; require_account "$name"; shift 2; else selected; fi
    if [[ "${1:-}" == -- ]]; then shift; fi
    prepare_shared "$name"
    shared_toml="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$shared")"
    exec env CODEX_HOME="$root/accounts/$name" codex -c 'cli_auth_credentials_store="file"' -c "sqlite_home=$shared_toml" --no-daemon "$@" ;;
  *) echo "Unknown command: $command_name" >&2; usage >&2; exit 2 ;;
esac
